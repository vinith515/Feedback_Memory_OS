# Feedback Memory OS: Environment Configuration
# Copy this file to .env and configure as needed.

# Hindsight Cloud or Self-Hosted Hindsight Instance
# Get an API key at https://ui.hindsight.vectorize.io
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_ID=workspace_nova_analytics

# Relational Application Database (PostgreSQL / SQLite)
DATABASE_URL=sqlite:///./feedback_memory.db

# LLM Provider Key (Optional if using Hindsight Cloud managed reflect)
LLM_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
